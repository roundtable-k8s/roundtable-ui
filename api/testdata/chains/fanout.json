{
  "apiVersion": "ai.roundtable.io/v1alpha1",
  "kind": "Chain",
  "metadata": {"name": "fanout-scan", "namespace": "roundtable"},
  "spec": {
    "steps": [
      {"name": "discover", "knightRef": {"name": "galahad"}, "task": "list hosts"},
      {
        "name": "scan",
        "knightRef": {"name": "galahad"},
        "task": "scan {{ .Item }}",
        "dependsOn": ["discover"],
        "forEach": {"from": "discover", "maxItems": 50},
        "maxParallel": 2,
        "failurePolicy": "continue"
      },
      {
        "name": "notify",
        "knightRef": {"name": "gawain"},
        "task": "notify",
        "dependsOn": ["discover"],
        "when": "steps.discover.output.contains(\"urgent\")"
      },
      {"name": "cleanup", "knightRef": {"name": "gawain"}, "task": "cleanup", "dependsOn": ["scan"]}
    ]
  },
