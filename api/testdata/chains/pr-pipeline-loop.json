  "apiVersion": "ai.roundtable.io/v1alpha1",
  "kind": "Chain",
  "metadata": {"name": "pr-pipeline-roundtable-ui-187", "namespace": "roundtable"},
  "spec": {
    "roundTableRef": {"name": "roundtable-dev"},
    "steps": [
      {"name": "implement", "knightRef": {"name": "rt-ui"}, "task": "implement"},
      {"name": "review", "knightRef": {"name": "rt-reviewer"}, "task": "review", "dependsOn": ["implement"]},
      {
        "name": "fixloop",
        "dependsOn": ["review"],
        "loop": {
          "from": "review",
          "until": "last.output.contains(\"Verdict: ship it\")",
          "maxIterations": 3,
          "onExhausted": "continue",
          "steps": [
            {"name": "fix", "knightRef": {"name": "rt-ui"}, "task": "fix {{ .Loop.Last.Output }}"},
            {"name": "rereview", "knightRef": {"name": "rt-reviewer"}, "task": "review again"}
          ]
        }
      },
      {"name": "merge", "knightRef": {"name": "rt-ui"}, "task": "merge", "dependsOn": ["fixloop"], "when": "steps.fixloop.outcome == \"Converged\""},
      {"name": "needs-human", "knightRef": {"name": "rt-ui"}, "task": "label", "dependsOn": ["fixloop"], "when": "steps.fixloop.outcome == \"Exhausted\""}
    ]
  },
